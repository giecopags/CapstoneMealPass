@model IEnumerable<TopUpLogs>

<div class="card shadow-sm rounded-lg mb-4" style="border-radius:12px; background-color:#f8f9fa;">
    <div class="card-body">
        <h4 class="card-title mb-4">Top-Up History</h4>

        <!-- DATE FILTER -->
        <div class="mb-3 d-flex align-items-center">
            <input type="date" id="topupFilterDate" class="form-control mr-2" style="max-width:200px;" />
            <button type="button" class="btn btn-secondary" id="clearTopUpFilter">Clear</button>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="topupTable">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th>
                        <th>Employee</th>
                        <th>Amount</th>
                        <th>Previous Balance</th>
                        <th>New Balance</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-date="@item.TopUpDate.ToString("yyyy-MM-dd")">
                            <td>@item.TopUpID</td>
                            <td>@item.Username</td>
                            <td>₱@item.Amount.ToString("N2")</td>
                            <td>₱@item.PreviousBalance.ToString("N2")</td>
                            <td>₱@item.NewBalance.ToString("N2")</td>
                            <td>@item.TopUpDate.ToString("MMMM dd, yyyy hh:mm tt")</td>
                            <td>
                                @if (item.Status == "Completed" || item.Status == "Success")
                                {
                                    <span class="badge badge-success">✔ @item.Status</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge badge-warning">@item.Status</span>
                                }
                                else if (item.Status == "Failed")
                                {
                                    <span class="badge badge-danger">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const topupFilter = document.getElementById("topupFilterDate");
    const topupTableRows = document.querySelectorAll("#topupTable tbody tr");
    const clearTopUpBtn = document.getElementById("clearTopUpFilter");

    topupFilter.addEventListener("change", function() {
        const selectedDate = this.value;
        topupTableRows.forEach(row => {
            const rowDate = row.getAttribute("data-date");
            row.style.display = (!selectedDate || rowDate === selectedDate) ? "" : "none";
        });
    });

    clearTopUpBtn.addEventListener("click", function() {
        topupFilter.value = "";
        topupTableRows.forEach(row => row.style.display = "");
    });
</script>
