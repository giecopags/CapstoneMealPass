@model IEnumerable<MealPass.Shared.Models.TopUpLogs>

<!-- Scroll to Top Button -->
<button id="scrollTopTopUpBtn" class="scroll-top-btn d-none">↑</button>

<div class="card shadow-sm rounded-lg mb-4" style="border-radius:12px; background-color:#f0f2f5;">
    <div class="card-body">
        <h4 class="card-title mb-4">Top-Up History</h4>

        <!-- ACCOUNT LOCK TOGGLE -->
        <div class="mb-4 d-flex align-items-center">
            <label class="mr-3 font-weight-bold">Lock Account:</label>

            <label class="switch">
                <input type="checkbox" id="lockAccountToggle"
                       @(ViewBag.IsLocked == true ? "checked" : "")>
                <span class="slider round"></span>
            </label>

            <span id="lockStatusText" class="ml-3 font-weight-bold"
                  data-locked="@(ViewBag.IsLocked == true ? 1 : 0)">
                @(ViewBag.IsLocked == true ? "Locked" : "Unlocked")
            </span>
        </div>

        <!-- DATE FILTER -->
        <div class="row mb-3 align-items-center">
            <div class="col-auto text-md-start text-center">
                <label for="filterDate" class="font-weight-bold mb-0">Filter by Date:</label>
            </div>

            <div class="col-auto">
                <input type="date" id="filterDate" class="form-control" style="width:auto; min-width:150px;">
            </div>

            <div class="col-auto">
                <button id="clearDateFilter" class="btn btn-secondary">Clear</button>
            </div>
        </div>

        <!-- CARD CONTAINER -->
        <div id="topupCardContainer" class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-sm-6 col-12 mb-3 topup-card"
                     data-date="@item.TopUpDate.ToString("yyyy-MM-dd")">
                    <div class="wallet-card p-3 rounded-lg shadow-sm">
                        <div class="wallet-card-header text-dark-green font-weight-bold">
                            Top-Up #@item.TopUpID
                        </div>

                        <div class="wallet-card-row">
                            <div class="wallet-card-label">Employee</div>
                            <div class="wallet-card-value">@item.Username</div>
                        </div>

                        <div class="wallet-card-row">
                            <div class="wallet-card-label">Amount</div>
                            <div class="wallet-card-value text-dark-green">₱@item.Amount.ToString("N2")</div>
                        </div>

                        <div class="wallet-card-row">
                            <div class="wallet-card-label">Previous Balance</div>
                            <div class="wallet-card-value">₱@item.PreviousBalance.ToString("N2")</div>
                        </div>

                        <div class="wallet-card-row">
                            <div class="wallet-card-label">New Balance</div>
                            <div class="wallet-card-value">₱@item.NewBalance.ToString("N2")</div>
                        </div>

                        <div class="wallet-card-row">
                            <div class="wallet-card-label">Date</div>
                            <div class="wallet-card-value">
                                @item.TopUpDate.ToString("dd/MM/yy hh:mm tt")
                            </div>
                        </div>

                        <div class="wallet-card-row">
                            <div class="wallet-card-label">Status</div>
                            <div class="wallet-card-value">
                                @if (item.Status == "Completed" || item.Status == "Success")
                                {
                                    <span class="badge badge-dark-green">✔ @item.Status</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge badge-warning">@item.Status</span>
                                }
                                else if (item.Status == "Failed")
                                {
                                    <span class="badge badge-danger">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">@item.Status</span>
                                }
                            </div>
                        </div>
                    </div>
                    </div>
            }
        </div>

        <div id="noTopUpMessage" class="text-center text-muted d-none">
            <p>No top-up records found for the selected date.</p>
        </div>
    </div>
</div>


<script>
    const topupFilter = document.getElementById("filterDate");
    const topupCards = document.querySelectorAll(".topup-card");
    const clearTopUpBtn = document.getElementById("clearDateFilter");
    const noTopUpMsg = document.getElementById("noTopUpMessage");
    const scrollTopBtn = document.getElementById("scrollTopTopUpBtn");

    function filterTopUps() {
        const selectedDate = topupFilter.value;
        let visibleCount = 0;

        topupCards.forEach(card => {
            const cardDate = card.getAttribute("data-date");
            if (!selectedDate || cardDate === selectedDate) {
                card.style.display = "";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });

        noTopUpMsg.classList.toggle("d-none", visibleCount > 0);

        scrollTopBtn.classList.toggle("d-none", visibleCount === 0);
    }

    topupFilter.addEventListener("change", filterTopUps);
    clearTopUpBtn.addEventListener("click", () => {
        topupFilter.value = "";
        filterTopUps();
    });

    scrollTopBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
    });

    filterTopUps();
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggle = document.getElementById("lockAccountToggle");
        const statusText = document.getElementById("lockStatusText");

        // Initial UI
        statusText.innerText = toggle.checked ? "Locked" : "Unlocked";
        statusText.style.color = toggle.checked ? "#dc3545" : "#28a745";

        toggle.addEventListener("change", async function () {
            const isLocked = toggle.checked ? 1 : 0;
            const action = toggle.checked ? "lock" : "unlock";

            if (!confirm(`Are you sure you want to ${action} your account?`)) {
                toggle.checked = !toggle.checked; // revert
                return;
            }

            try {
                const response = await fetch('@Url.Action("ToggleAccountLock", "MealPass")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(isLocked)
                });

                const data = await response.json();

                if (data.success) {
                    statusText.innerText = data.isLocked == 1 ? "Locked" : "Unlocked";
                    statusText.style.color = data.isLocked == 1 ? "#dc3545" : "#28a745";
                } else {
                    throw new Error(data.message || "Failed to update lock status");
                }
            } catch (err) {
                console.error(err);
                alert("Error updating lock status. Please try again.");
                toggle.checked = !toggle.checked; // revert UI
            }
        });
    });
</script>
