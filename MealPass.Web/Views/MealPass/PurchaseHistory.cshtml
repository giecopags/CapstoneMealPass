@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<Transactions>

<!-- BALANCE DASHBOARD -->
<div class="row mb-4">
    <!-- Current Balance Card -->
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm rounded border-light text-center p-3"
             style="background: linear-gradient(135deg, #006400, #228B22); color:white;">
            <h6 class="mb-2 font-weight-bold">Current Balance</h6>
            <p class="mb-0" style="font-size:1.5rem; font-weight:700;" id="currentBalance">
                ₱@ViewBag.CurrentBalance.ToString("N2")
            </p>
        </div>
    </div>

    <!-- Total Amount Topped Up Card -->
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm rounded border-light text-center p-3"
             style="background: linear-gradient(135deg, #004d4d, #008080); color:white;">
            <h6 class="mb-2 font-weight-bold">Total Amount Topped Up</h6>
            <p class="mb-0" style="font-size:1.5rem; font-weight:700;" id="totalToppedUp">
                ₱@ViewBag.TotalToppedUp.ToString("N2")
            </p>
        </div>
    </div>
</div>


<!-- DATE FILTER -->
<div class="row mb-3">
    <div class="col-md-12 d-flex align-items-center">
        <label for="filterDate" class="mr-2 font-weight-bold">Filter by Date:</label>
        <input type="date" id="filterDate" class="form-control w-auto">
        <button id="clearDateFilter" class="btn btn-secondary ml-2">Clear</button>
    </div>
</div>

<!-- PURCHASE HISTORY TABLE -->
<div class="row">
    <div class="col-md-12 mb-4">
        <div class="card shadow-sm rounded border-light">
            <div class="card-body">
                <h4 class="mb-3">Purchase History</h4>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered" id="transactionTable">
                        <thead class="thead-dark">
                            <tr>
                                <th>Reference ID</th>
                                <th>Date</th>
                                <th>Employee</th>
                                <th>Payment Method</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody id="transactionTableBody">
                            @foreach (var item in Model)
                            {
                                <tr data-ref="@item.ReferenceID" data-date="@item.SaleDate.ToString("yyyy-MM-dd")" style="cursor:pointer;">
                                    <td>@item.ReferenceID</td>
                                    <td>@item.SaleDate.ToString("MMMM dd, yyyy hh:mm tt")</td>
                                    <td>@item.Username</td>
                                    <td>@(item.PaymentMethod ? "Cash" : "MealPass")</td>
                                    <td>₱@item.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TRANSACTION DETAILS TABLE -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm rounded border-light">
            <div class="card-body">
                <h4 class="mb-3">Transaction Details</h4>

                <div id="detailsSection">
                    <p class="text-muted">Select a transaction to display details.</p>
                </div>

                <div class="table-responsive d-none" id="detailsTableWrapper">
                    <table class="table table-hover table-bordered" id="detailsTable">
                        <thead class="thead-dark">
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div class="text-right mt-3 border-top pt-2">
                        <h5 style="font-weight:700; font-size:1.2rem;">
                            Grand Total:
                            <span id="grandTotalDisplay" style="color:#1b7d4f;">₱0.00</span>
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Show transaction details
    function bindTransactionRows() {
        document.querySelectorAll("#transactionTable tbody tr").forEach(row => {
            row.addEventListener("click", function () {
                let referenceId = this.getAttribute("data-ref");

                fetch(`/MealPass/GetTransactionDetails?referenceId=${referenceId}`)
                    .then(res => res.json())
                    .then(data => {
                        let tbody = document.querySelector("#detailsTable tbody");
                        tbody.innerHTML = "";
                        let grandTotal = 0;

                        data.forEach(item => {
                            grandTotal += item.subtotal;
                            tbody.innerHTML += `
                                <tr>
                                    <td>${item.productName}</td>
                                    <td>${item.quantitySold}</td>
                                    <td>₱${item.unitPrice.toFixed(2)}</td>
                                    <td>₱${item.subtotal.toFixed(2)}</td>
                                </tr>`;
                        });

                        document.getElementById("grandTotalDisplay").innerText =
                            "₱" + grandTotal.toFixed(2);

                        document.getElementById("detailsTableWrapper").classList.remove("d-none");
                        document.getElementById("detailsSection").classList.add("d-none");
                    })
                    .catch(err => console.error("Error fetching transaction details:", err));
            });
        });
    }

    bindTransactionRows();

    // Filter transactions by date
    const filterDateInput = document.getElementById("filterDate");
    filterDateInput.addEventListener("change", function () {
        const selectedDate = this.value;
        document.querySelectorAll("#transactionTable tbody tr").forEach(row => {
            const rowDate = row.getAttribute("data-date");
            row.style.display = (!selectedDate || rowDate === selectedDate) ? "" : "none";
        });

        // Clear transaction details when filtering
        document.getElementById("detailsTableWrapper").classList.add("d-none");
        document.getElementById("detailsSection").classList.remove("d-none");
        document.getElementById("grandTotalDisplay").innerText = "₱0.00";
    });

    // Clear filter and reset everything
    document.getElementById("clearDateFilter").addEventListener("click", function() {
        filterDateInput.value = "";
        document.querySelectorAll("#transactionTable tbody tr").forEach(row => {
            row.style.display = "";
        });

        document.getElementById("detailsTableWrapper").classList.add("d-none");
        document.getElementById("detailsSection").classList.remove("d-none");
        document.querySelector("#detailsTable tbody").innerHTML = "";
        document.getElementById("grandTotalDisplay").innerText = "₱0.00";
    });
</script>
