@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<MealPass.Shared.Models.Transactions>

<button id="scrollTopBtn" class="scroll-top-btn d-none">
    ↑
</button>

<!-- BALANCE DASHBOARD -->
<div class="row mb-4">
    <!-- Current Balance Card -->
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm rounded border-light text-center p-3"
             style="background: linear-gradient(135deg, #006400, #228B22); color:white;">
            <h6 class="mb-2 font-weight-bold">Current Balance</h6>
            <p class="mb-0" style="font-size:1.5rem; font-weight:700;" id="currentBalance">
                ₱@ViewBag.CurrentBalance.ToString("N2")
            </p>
        </div>
    </div>

    <!-- Total Amount Topped Up Card -->
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm rounded border-light text-center p-3"
             style="background: linear-gradient(135deg, #004d4d, #008080); color:white;">
            <h6 class="mb-2 font-weight-bold">Total Amount Topped Up</h6>
            <p class="mb-0" style="font-size:1.5rem; font-weight:700;" id="totalToppedUp">
                ₱@ViewBag.TotalToppedUp.ToString("N2")
            </p>
        </div>
    </div>
</div>


<!-- DATE FILTER -->
<div class="row mb-3 align-items-center">
    <div class="col-auto text-md-start text-center">
        <label for="filterDate" class="font-weight-bold mb-0">Filter by Date:</label>
    </div>

    <div class="col-auto">
        <input type="date" id="filterDate" class="form-control" style="width:auto; min-width:150px;">
    </div>

    <div class="col-auto">
        <button id="clearDateFilter" class="btn btn-secondary">Clear</button>
    </div>
</div>

<!-- PURCHASE HISTORY – CARD VIEW -->
<div id="transactionCardContainer" class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 col-sm-6 col-12 mb-3">
            <div class="modern-card transaction-card"
                 data-ref="@item.ReferenceID"
                 data-date="@item.SaleDate.ToString("yyyy-MM-dd")">

                <div class="card-title-main">@item.ReferenceID</div>

                <div>
                    <div class="card-mini-label">Date</div>
                    <div class="card-mini-value">@item.SaleDate.ToString("MMMM dd, yyyy hh:mm tt")</div>
                </div>

                <div>
                    <div class="card-mini-label">Employee</div>
                    <div class="card-mini-value">@item.Username</div>
                </div>

                <div>
                    <div class="card-mini-label">Payment Method</div>
                    <div class="card-mini-value">@(item.PaymentMethod ? "Cash" : "MealPass")</div>
                </div>

                <div class="card-amount">
                    ₱@item.TotalAmount.ToString("N2")
                </div>
            </div>
        </div>
    }
</div>


<!-- TRANSACTION DETAILS – CARD VIEW -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm rounded border-light">
            <div class="card-body">
                <h4 class="mb-3">Transaction Details</h4>

                <div id="detailsSection">
                    <p class="text-muted">Select a transaction to display details.</p>
                </div>

                <!-- CARD VIEW CONTAINER -->
                <div id="detailsCardContainer" class="d-none">
                </div>

                <div class="text-right mt-4 border-top pt-2 d-none" id="grandTotalWrapper">
                    <h5 class="font-weight-bold" style="font-size: 1.3rem;">
                        Grand Total:
                        <span id="grandTotalDisplay" style="color:#1b7d4f;">₱0.00</span>
                    </h5>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
     // Bind click events to transaction cards
       function bindTransactionCards() {
        document.querySelectorAll(".transaction-card").forEach(card => {
            card.addEventListener("click", function () {
                let referenceId = this.getAttribute("data-ref");

                fetch(`/MealPass/GetTransactionDetails?referenceId=${referenceId}`)
                    .then(res => res.json())
                    .then(data => {
                        let container = document.getElementById("detailsCardContainer");
                        container.innerHTML = "";
                        let grandTotal = 0;

                        data.forEach(item => {
                            grandTotal += item.subtotal;

                            container.innerHTML += `
                                <div class="detail-card">
                                    <div class="detail-card-title">${item.productName}</div>

                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <div class="detail-label">Qty</div>
                                            <div class="detail-value">${item.quantitySold}</div>
                                        </div>

                                        <div class="col-6 text-right">
                                            <div class="detail-label">Price</div>
                                            <div class="detail-value">₱${item.unitPrice.toFixed(2)}</div>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-12 text-right">
                                            <div class="detail-label">Subtotal</div>
                                            <div class="amount">₱${item.subtotal.toFixed(2)}</div>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });

                        document.getElementById("grandTotalDisplay").innerText =
                            "₱" + grandTotal.toFixed(2);

                        document.getElementById("detailsCardContainer").classList.remove("d-none");
                        document.getElementById("detailsSection").classList.add("d-none");
                        document.getElementById("grandTotalWrapper").classList.remove("d-none");
                        document.getElementById("scrollTopBtn").classList.remove("d-none");

                        document.getElementById("detailsCardContainer").scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                    })
                    .catch(err => console.error("Error fetching transaction details:", err));
            });
        });
    }
    bindTransactionCards();
</script>

<script>
    const filterInput = document.getElementById("filterDate");
    const clearBtn = document.getElementById("clearDateFilter");

    function clearTransactionDetails() {
        document.getElementById("detailsCardContainer").classList.add("d-none");
        document.getElementById("detailsCardContainer").innerHTML = "";
        document.getElementById("detailsSection").classList.remove("d-none");
        document.getElementById("grandTotalWrapper").classList.add("d-none");
        document.getElementById("scrollTopBtn").classList.add("d-none");

    }

    filterInput.addEventListener("change", function () {
        let selectedDate = this.value; // yyyy-MM-dd
        let cards = document.querySelectorAll(".transaction-card");
        let visibleCount = 0;

        cards.forEach(card => {
            let cardDate = card.getAttribute("data-date");

            if (!selectedDate || cardDate === selectedDate) {
                card.parentElement.style.display = "";
                visibleCount++;
            } else {
                card.parentElement.style.display = "none";
            }
        });

        if (visibleCount === 0) {
            clearTransactionDetails();
        }
    });

    clearBtn.addEventListener("click", function () {
        filterInput.value = "";
        let cards = document.querySelectorAll(".transaction-card");

        cards.forEach(card => {
            card.parentElement.style.display = "";
        });

        clearTransactionDetails();
    });

        document.getElementById("scrollTopBtn").addEventListener("click", function () {
        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    });
</script>


