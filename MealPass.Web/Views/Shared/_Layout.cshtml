﻿@{
Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>DMC - MealPass</title>

    <link rel="stylesheet" href="~/content/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/content/vendors/flag-icon-css/css/flag-icon.min.css">
    <link rel="stylesheet" href="~/content/vendors/css/vendor.bundle.base.css">

    <link rel="stylesheet" href="~/content/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/content/vendors/bootstrap-datepicker/bootstrap-datepicker.min.css">

    <link rel="stylesheet" href="~/content/css/style.css">
    <link rel="shortcut icon" href="~/content/images/mp-small.png" />
</head>

<body>
    <div class="container-scroller">
        <!-- Top Navbar -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a class="navbar-brand brand-logo" href="#"><img src="~/content/images/mp-logo.svg" alt="logo" /></a>
                <a class="navbar-brand brand-logo-mini" href="#"><img src="~/content/images/mp-small.png" alt="logo" /></a>
            </div>

            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <!-- ✅ Burger menu toggle retained -->
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </button>

                <ul class="navbar-nav navbar-nav-right ml-auto">
                    <li class="nav-item d-flex align-items-center">
                        <div class="nav-profile-img mr-2">
                            <img src="~/content/images/faces/user-logo.png" alt="image" style="width:36px; height:36px; border-radius:50%;">
                        </div>
                        <div class="nav-profile-text mr-3">
                            <p class="mb-0 text-black">@Context.Session.GetString("FirstName")</p>
                        </div>
                    </li>
                </ul>

                <!-- ✅ Mobile burger toggle -->
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav>
        <!-- End Top Navbar -->

        <div class="container-fluid page-body-wrapper">
            <!-- Sidebar -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item nav-category">Main Menu</li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("PurchaseHistory", "MealPass")">
                            <span class="icon-bg"><i class="mdi mdi-cart menu-icon"></i></span>
                            <span class="menu-title">Purchase History</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("TopUpHistory", "MealPass")">
                            <span class="icon-bg"><i class="mdi mdi-wallet menu-icon"></i></span>
                            <span class="menu-title">Top-up History</span>
                        </a>
                    </li>

                    <li class="nav-item sidebar-user-actions mt-4">
                        <div class="sidebar-user-menu">
                            <a href="@Url.Action("Logout", "MealPass")" class="nav-link">
                                <i class="mdi mdi-logout menu-icon"></i>
                                <span class="menu-title">Log Out</span>
                            </a>
                        </div>
                    </li>

                </ul>
            </nav>
            <!-- End Sidebar -->
            <!-- Main Content -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>

                <!-- Footer -->
                <footer class="footer">
                    <div class="footer-inner-wraper text-center">
                        <span class="text-muted d-block">© 2025 DMC MealPass. All rights reserved.</span>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- scripts -->
    <script src="~/content/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/content/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script src="~/content/js/off-canvas.js"></script>
    <script src="~/content/js/hoverable-collapse.js"></script>
    <script src="~/content/js/misc.js"></script>
    <script src="~/content/js/dashboard.js"></script>
</body>
</html>